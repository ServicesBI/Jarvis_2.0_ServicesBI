{
  "manifest_version": 3,
  "name": "JARVIS OpenAI Balance Bridge",
  "version": "1.0.2",
  "description": "Envia somente o saldo do card Credit balance para o JARVIS local.",
  "key": "",
  "permissions": [],
  "host_permissions": ["https://platform.openai.com/*", "http://127.0.0.1:8000/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://platform.openai.com/*"],
    "js": ["parser.js", "content.js"],
    "run_at": "document_idle"
  }]
}
