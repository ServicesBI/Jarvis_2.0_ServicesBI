HOST=127.0.0.1
PORT=8000
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
CLAUDE_CLI_PATH=
CLAUDE_PLAN=
JARVIS_CODEX_CMD=
JARVIS_EXECUTOR_MODE=
OBSIDIAN_VAULT=
OPENAI_ADMIN_KEY=
OPENAI_CREDIT_BASE_USD=
OPENAI_CREDIT_BASE_AT=
OPENAI_BALANCE_REFRESH_MS=300000
JARVIS_UPDATE_GITHUB_TOKEN=

# PostgreSQL dedicado do Jarvis (P0/P1 — fundação, ainda não usado pelo runtime).
# Nunca commitar credencial real aqui. Formato esperado:
# postgresql+psycopg://usuario:senha@host:5432/nome_do_banco
JARVIS_DATABASE_URL=
# Banco de teste ISOLADO, nunca o mesmo de JARVIS_DATABASE_URL. Sem esta
# variável, os testes de integração PostgreSQL fazem SKIP explícito.
JARVIS_TEST_DATABASE_URL=
